# Copy sang .env rồi điền — KHÔNG commit file .env

# Supabase (P1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role key — chỉ dùng cho tools/seed_mqtt_credential.ps1 (đừng đưa vào app)
SUPABASE_SERVICE_KEY=

# HiveMQ Cloud: HIVE_MQTT_USER/PASS chính là credential shared `device-family`
# (đã tạo trong console, ≤32 ký tự) — seed script đọc chúng để nạp vào Supabase app_secrets
HIVE_MQTT_HOST=
HIVE_MQTT_PORT=8883
HIVE_MQTT_USER=
HIVE_MQTT_PASS=

# Build-time secret firmware (scripts/build_env.py nhúng thành DEFINE FW_SECRET):
# seed mã hóa mqttPass trong config = deviceId + FW_SECRET. Chỉ hex/alnum (được
# nhúng thẳng vào build flag), khuyến nghị ≤64 ký tự. Để RỖNG = tương đương build cũ.
FW_SECRET=

